# Environment variables for Expense Tracker Backend
# Copy this file to .env and fill in your values
# NEVER commit the real .env file

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/expense_tracker

# Alternatively, use individual variables (choose ONE approach):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=expense_tracker
# DB_USER=postgres
# DB_PASSWORD=YOUR_PASSWORD

# Server port
PORT=5000

# Frontend origin (React dev server)
CLIENT_URL=http://localhost:5173
